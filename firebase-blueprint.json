    "Activity": {
      "title": "Activity",
      "description": "Longitudinal student activity from 6th to 12th grade formatted with exact Common App constraints, personal growth impactScore (1-5), and reflections.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the student who owns this activity.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "activityType": {
          "type": "string",
          "description": "Official Common App activity category.",
          "minLength": 1,
          "maxLength": 60
        },
        "position": {
          "type": "string",
          "description": "Common App Position/Leadership description (strictly max 50 chars).",
          "minLength": 1,
          "maxLength": 50
        },
        "organization": {
          "type": "string",
          "description": "Common App Organization Name (strictly max 100 chars).",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Common App Activity Description (strictly max 150 chars).",
          "minLength": 1,
          "maxLength": 150
        },
        "extendedNotes": {
          "type": "string",
          "description": "Personal reflection, growth story, and memories for this activity.",
          "minLength": 0,
          "maxLength": 2000
        },
        "grades": {
          "type": "array",
          "description": "List of grades participated (integers from 6 to 12, max 7 items)."
        },
        "timing": {
          "type": "string",
          "description": "Common App participation timing.",
          "enum": ["School Year", "School Break", "All Year"],
          "minLength": 1,
          "maxLength": 20
        },
        "hoursPerWeek": {
          "type": "number",
          "description": "Hours spent per week (0.5 to 80)."
        },
        "weeksPerYear": {
          "type": "number",
          "description": "Weeks spent per year (1 to 52)."
        },
        "continueInCollege": {
          "type": "boolean",
          "description": "Whether student intends to participate in a similar activity in college."
        },
        "commonAppSlot": {
          "type": "integer",
          "description": "Priority slot 1-10 for official Common App export (0 means unslotted)."
        },
        "impactScore": {
          "type": "integer",
          "description": "1-5 rating of how meaningful this activity was to the student's personal growth."
        },
        "studentId": {
          "type": "string",
          "description": "Optional identifier of the student/child in a multi-child family portfolio.",
          "minLength": 0,
          "maxLength": 80
        },
        "studentName": {
          "type": "string",
          "description": "Optional display name of the student/child in a multi-child family portfolio.",
          "minLength": 0,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "activityType",
        "position",
        "organization",
        "description",
        "extendedNotes",
        "grades",
        "timing",
        "hoursPerWeek",
        "weeksPerYear",
        "continueInCollege",
        "commonAppSlot",
        "impactScore",
        "createdAt",
        "updatedAt"
      ]
    },
