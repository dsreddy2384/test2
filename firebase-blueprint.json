{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student profile storing current grade level, graduation year, gamified XP, and journal streak metrics.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Immutable Firebase Auth UID of the student owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Student display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "currentGrade": {
          "type": "integer",
          "description": "Current school grade from 6 to 12."
        },
        "gradYear": {
          "type": "integer",
          "description": "High school graduation year (e.g., 2026 to 2035)."
        },
        "dreamColleges": {
          "type": "string",
          "description": "Comma-separated target colleges or goals.",
          "minLength": 0,
          "maxLength": 200
        },
        "streakDays": {
          "type": "integer",
          "description": "Consecutive days of reflection journaling."
        },
        "xp": {
          "type": "integer",
          "description": "Total gamified experience points earned from logging activities, reflections, and honors."
        },
        "lastCheckInDate": {
          "type": "string",
          "description": "ISO date string (YYYY-MM-DD) of most recent journal check-in.",
          "minLength": 0,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": [
        "uid",
        "displayName",
        "currentGrade",
        "gradYear",
        "dreamColleges",
        "streakDays",
        "xp",
        "lastCheckInDate",
        "createdAt",
        "updatedAt"
      ]
    },
